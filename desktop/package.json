{
  "name": "ajd-wireless-repairs-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "AJD's Wireless Repairs Admin Desktop — Secure Repair Tracker & Store Manager",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run prepare:icons && electron .",
    "dist:win": "npm run prepare:icons && electron-builder --win nsis --x64",
    "dist:mac": "npm run prepare:icons && electron-builder --mac dmg --universal",
    "prepare:icons": "node prepare-assets.cjs"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "org.ajdapp.wirelessrepairs",
    "productName": "AJD's Wireless Repairs",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "intro.html",
      "icon.png"
    ],
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AJD-Wireless-Repairs-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "AJD-Wireless-Repairs-macOS.dmg"
    },
    "dmg": {
      "title": "AJD’s Wireless Repairs",
      "backgroundColor": "#111c28"
    }
  }
}
